NODE_ENV=development
PORT=3000

# Base PostgreSQL (docker-compose : port hôte 5433)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=logitruck_db
DB_USER=logitruck_user
DB_PASSWORD=logitruckpass

# Au moins 32 caractères aléatoires :  openssl rand -hex 32
JWT_SECRET=f7a0a4e9f2152c425b024c35d972b062ab352efcc0ffe240ae349dbbf730a9d9
JWT_EXPIRES_IN=7d

# Origines autorisées, séparées par des virgules (obligatoire en production, jamais "*")
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Derrière un reverse proxy (nginx, Render, ...) : nombre de proxys de confiance
# TRUST_PROXY=1

# Commission plateforme (0.10 = 10 %)
PLATFORM_COMMISSION_RATE=0.10

# --- KKiaPay (https://app.kkiapay.me → Développeurs → Clés API) ---
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
# "secret hash" saisi dans Webhook : KKiaPay le renvoie dans l'en-tête x-kkiapay-secret
KKIAPAY_WEBHOOK_SECRET=
# true = bac à sable ; mettre false uniquement en production
KKIAPAY_SANDBOX=true

# --- Reversement chauffeur (90 %) ---
# manual (défaut) : l'admin verse en Mobile Money puis clique "Marqué payé" dans le tableau de bord
# webhook         : appelle PAYOUT_WEBHOOK_URL (votre service de virement), avec une clé d'idempotence
PAYOUT_MODE=manual
# PAYOUT_WEBHOOK_URL=
# PAYOUT_WEBHOOK_TOKEN=

# OSRM (calcul d'itinéraire). Pour la prod, hébergez le vôtre ou utilisez un fournisseur.
# OSRM_URL=https://router.project-osrm.org
