# URL de l'API Backend BenneGo (sans slash final)
# Laisser vide en développement local si proxy Vite utilisé, ou pointer vers l'URL de l'API
VITE_API_URL=http://localhost:3000

# URL Socket.IO du backend BenneGo (sans slash final)
VITE_SOCKET_URL=http://localhost:3000

# Clé Google Maps (fond de carte comme Gozem, recherche d'adresses, nom des lieux).
# APIs à activer : Maps JavaScript API, Places API (New), Geocoding API. Sans clé : carte OpenStreetMap.
VITE_GOOGLE_MAPS_KEY=
