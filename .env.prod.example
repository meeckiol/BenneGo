# Production : copiez en .env.prod (ignoré par git) puis remplissez toutes les valeurs.
# Usage : docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- Base de données (réseau interne Docker, non exposée) ---
POSTGRES_DB=bennego_db
POSTGRES_USER=bennego_user
POSTGRES_PASSWORD=

# --- API ---
# Au moins 32 caractères aléatoires :  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Origines des trois fronts, séparées par des virgules (jamais "*")
CORS_ORIGIN=https://bennego.example.com,https://driver.bennego.example.com,https://admin.bennego.example.com
PLATFORM_COMMISSION_RATE=0.10

# --- KKiaPay (obligatoires en production : le backend refuse de démarrer sans elles) ---
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
KKIAPAY_WEBHOOK_SECRET=
KKIAPAY_SANDBOX=false

# --- Reversement chauffeur ---
PAYOUT_MODE=manual
# PAYOUT_WEBHOOK_URL=
# PAYOUT_WEBHOOK_TOKEN=

# --- Application (liens envoyés par WhatsApp et SMS) ---
APP_PUBLIC_URL=https://bennego.example.com

# --- SMS : codes de vérification à l'inscription (obligatoire : sans passerelle, l'inscription est bloquée) ---
# Passerelle SMS (agrégateur béninois ou autre) appelée en POST { to, message }
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# --- WhatsApp Cloud API (Meta) : commandes par message texte ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Calcul d'itinéraire ---
OSRM_URL=https://router.project-osrm.org
