{
  "name": "logitruck",
  "version": "1.0.0",
  "description": "Plateforme Uber pour camions de chantier au Bénin",
  "private": true,
  "workspaces": [
    "backend",
    "frontend-client",
    "frontend-driver",
    "frontend-admin"
  ],
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:client": "cd frontend-client && npm run dev",
    "dev:driver": "cd frontend-driver && npm run dev",
    "dev:admin": "cd frontend-admin && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:client\"",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
