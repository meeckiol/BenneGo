{
  "name": "bennego",
  "version": "1.0.0",
  "description": "BenneGo — plateforme de livraison de matériaux de chantier (Bénin) avec paiement en séquestre",
  "private": true,
  "workspaces": [
    "backend",
    "frontend-client",
    "frontend-driver",
    "frontend-admin"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:client": "npm run dev -w frontend-client",
    "dev:driver": "npm run dev -w frontend-driver",
    "dev:admin": "npm run dev -w frontend-admin",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:client\" \"npm run dev:driver\" \"npm run dev:admin\"",
    "build": "npm run build -w frontend-client && npm run build -w frontend-driver && npm run build -w frontend-admin",
    "online": "node scripts/start-online.js",
    "migrate": "npm run migrate -w backend",
    "test": "npm test -w backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "seed:demo": "npm run seed-demo -w backend",
    "e2e": "playwright test -c e2e/playwright.config.js",
    "test:web": "node --test e2e/unit/*.test.mjs",
    "test:all": "npm test && npm run test:web && npm run e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "concurrently": "^8.2.2"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "@kkiapay-org/nodejs-sdk": {
      "axios": "1.20.0"
    }
  }
}
