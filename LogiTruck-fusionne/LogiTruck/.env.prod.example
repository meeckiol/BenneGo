# ══════════════════════════════════════════════════════════════════════════════
# LogiTruck — Configuration de PRODUCTION
# Copiez ce fichier en .env.prod et renseignez chaque valeur.
#
#   cp .env.prod.example .env.prod
#
# ⚠️  Ne commitez JAMAIS .env.prod dans Git.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Base de données PostgreSQL ───────────────────────────────────────────────
# Mot de passe fort (ex: openssl rand -hex 32)
POSTGRES_DB=logitruck_db
POSTGRES_USER=logitruck_user
POSTGRES_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort

# ─── Backend ──────────────────────────────────────────────────────────────────
# Clé secrète JWT — au moins 64 caractères aléatoires
#   openssl rand -hex 64
JWT_SECRET=CHANGEZ_MOI_cle_jwt_64_caracteres_minimum
JWT_EXPIRES_IN=7d

# Origines CORS autorisées (vos vrais domaines, sans slash final)
CORS_ORIGIN=https://logitruck.example.com,https://driver.logitruck.example.com,https://admin.logitruck.example.com

# Commission plateforme (0.10 = 10 %)
PLATFORM_COMMISSION_RATE=0.10

# ─── KKiaPay (https://app.kkiapay.me → Développeurs → Clés API) ─────────────
# Clés de PRODUCTION (pas les clés sandbox)
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=

# Secret du webhook KKiaPay
# Dashboard KKiaPay → Webhook → "Secret hash" (choisissez-le librement)
KKIAPAY_WEBHOOK_SECRET=CHANGEZ_MOI_webhook_secret

# false en production (true uniquement pour les tests sandbox)
KKIAPAY_SANDBOX=false

# ─── Reversement chauffeur ────────────────────────────────────────────────────
# manual  : l'admin verse manuellement puis clique "Marquer payé"
# webhook : appelle PAYOUT_WEBHOOK_URL automatiquement
PAYOUT_MODE=manual
# PAYOUT_WEBHOOK_URL=https://votre-service-virement.example.com/payout
# PAYOUT_WEBHOOK_TOKEN=CHANGEZ_MOI_token_secret_virement

# ─── OSRM (calcul d'itinéraire GPS) ─────────────────────────────────────────
# En production, hébergez votre propre instance OSRM pour éviter la dépendance
# à un service public (quotas, disponibilité).
# Instance publique (ok pour MVP, peu fiable en prod) :
OSRM_URL=https://router.project-osrm.org
# Instance privée (recommandé) :
# OSRM_URL=https://osrm.votre-domaine.example.com

# ─── Domaines (utilisés par certbot pour obtenir les certificats SSL) ─────────
# Remplacer par vos vrais domaines pointant vers ce serveur
DOMAIN_CLIENT=logitruck.example.com
DOMAIN_DRIVER=driver.logitruck.example.com
DOMAIN_ADMIN=admin.logitruck.example.com
# Email pour les alertes d'expiration Let's Encrypt
CERTBOT_EMAIL=admin@example.com
